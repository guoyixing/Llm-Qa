# 多项目代码审查示例环境配置
# 仅配置项目同步、规范用户身份、领导路由和 SMTP；真实敏感值不得提交。

# 三个固定项目只配置仓库 URL；目录、分支和 remote 由受信同步脚本固定
PROJECT_API_REPO_URL=https://example.com/acme/api.git
PROJECT_WEB_REPO_URL=https://example.com/acme/web.git
PROJECT_JOBS_REPO_URL=https://example.com/acme/jobs.git

# 规范用户、Git Author Email 与专属领导映射
USER_1_ID=alice
USER_1_GIT_EMAIL=alice@example.com
USER_1_LEADER_EMAIL=leader-a@example.com

USER_2_ID=bob
USER_2_GIT_EMAIL=bob@example.com
USER_2_LEADER_EMAIL=leader-b@example.com

# 用户未配置专属领导时使用的默认领导邮箱
DEFAULT_LEADER_EMAIL=lead@example.com

# SMTP 投递设置；认证信息按实际服务填写
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=review-bot@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
