# 多项目代码审查示例环境配置
# 仅配置项目同步、规范用户身份、领导路由和 SMTP；真实敏感值不得提交。

# 项目成员、目录、分支和仓库 URL 配置键来自 project-registry.yaml
PROJECT_HISENSE_IDS_APP_REPO_URL=https://example.com/hisense/ids-app.git
# HTTP 或 HTTPS 仓库需要认证时，手动取消下面两行的注释并同时填写；保持缺失则匿名访问
# HTTP 不提供 TLS 保护，凭据可能被明文窃听或篡改；应优先迁移至 HTTPS
# PROJECT_HISENSE_IDS_APP_REPO_USERNAME=<手动填写用户名>
# PROJECT_HISENSE_IDS_APP_REPO_PASSWORD=<手动填写密码>

# 规范用户、Git Author Email 与专属领导映射
USER_1_ID=alice
USER_1_NAME=张三
USER_1_GIT_EMAIL=alice@example.com
USER_1_LEADER_EMAIL=leader-a@example.com

USER_2_ID=bob
USER_2_NAME=李四
USER_2_GIT_EMAIL=bob@example.com
USER_2_LEADER_EMAIL=leader-b@example.com

# 用户未配置专属领导时使用的默认领导邮箱
DEFAULT_LEADER_EMAIL=lead@example.com

# SMTP 投递设置；认证信息按实际服务填写
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=review-bot@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
