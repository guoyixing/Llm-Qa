{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_REVIEW_MODEL}",
  "instructions": [
    "AGENTS.md"
  ],
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "formatter": false,
  "lsp": false,
  "permission": {
    "*": "deny",
    "task": "allow",
    "read": {
      "*": "deny",
      "AGENTS.md": "allow",
      "opencode.json": "allow",
      "project-registry.yaml": "allow",
      "tools/project_registry.py": "allow",
      "tools/registry_yaml.py": "allow",
      "tools/registry_snapshot.py": "allow",
      "tools/repository_config.py": "allow",
      "tools/sync_cli.py": "allow",
      "tools/path_safety.py": "allow",
      "tests/test_project_registry.py": "allow",
      "tests/test_sync_safety.py": "allow",
      "tests/test_sync_repositories.py": "allow",
      "tests/test_command_contracts.py": "allow",
      "tests/test_opencode_git_permissions.py": "allow",
      "tests/test_opencode_permissions.py": "allow",
      ".opencode/**": "allow",
      "standards/**": "allow",
      "data/code": "allow",
      "data/code/**": "allow",
      "tools/sync_repositories.py": "allow",
      "tools/sync_safety.py": "allow",
      "tools/send_mail.py": "allow",
      "reports/**": "deny",
      "reports/daily/**/*.md": "allow",
      "reports/daily/**/*.html": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "edit": {
      "*": "allow",
      ".git": "deny",
      ".git/**": "deny",
      "OPENCODE_COMMIT_MESSAGE": "allow",
      "reports/**": "deny",
      "reports/daily/**/*.md": "allow",
      "reports/daily/**/*.html": "allow"
    },
    "glob": "deny",
    "grep": "deny",
    "skill": {
      "*": "deny",
      "code-review-email-style": "allow"
    },
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "deny",
      "cat *": "deny",
      "type *": "deny",
      "Get-Content *": "deny",
      "env": "deny",
      "env *": "deny",
      "set": "deny",
      "set *": "deny",
      "export *": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "*Env:*": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",
      "bun *": "deny",
      "deno *": "deny",
      "uv *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "poetry *": "deny",
      "cargo *": "deny",
      "go *": "deny",
      "dotnet *": "deny",
      "mvn *": "deny",
      "gradle *": "deny",
      "gradlew *": "deny",
      "make *": "deny",
      "cmake *": "deny",
      "pytest *": "deny",
      "tox *": "deny",
      "nox *": "deny",
      "python -m pytest *": "deny",
      "python -m unittest *": "deny",
      "python *": "deny",
      "./.venv/Scripts/python.exe -m pytest *": "deny",
      "./.venv/Scripts/python.exe -m unittest *": "deny",
      "./.venv/Scripts/python.exe *": "deny",
      "git *": "deny",
      "git --no-pager -c core.hooksPath=NUL -c core.fsmonitor=false -c core.pager=cat -c color.ui=false -c diff.external= -c interactive.diffFilter= -c protocol.ext.allow=never log --no-show-signature --no-ext-diff --no-textconv --no-color *": "allow",
      "git --no-pager -c core.hooksPath=NUL -c core.fsmonitor=false -c core.pager=cat -c color.ui=false -c diff.external= -c interactive.diffFilter= -c protocol.ext.allow=never diff --no-ext-diff --no-textconv --no-color *": "allow",
      "git --no-pager -c core.hooksPath=NUL -c core.fsmonitor=false -c core.pager=cat -c color.ui=false -c diff.external= -c interactive.diffFilter= -c protocol.ext.allow=never show --no-show-signature --no-ext-diff --no-textconv --no-color *": "allow",
      "git status": "allow",
      "git status --short": "allow",
      "git add -- *": "allow",
      "git commit -F OPENCODE_COMMIT_MESSAGE": "allow",
      "./.venv/Scripts/python.exe -m unittest tests.test_project_registry -v": "allow",
      "./.venv/Scripts/python.exe -m unittest tests.test_sync_safety -v": "allow",
      "./.venv/Scripts/python.exe -m unittest tests.test_sync_repositories -v": "allow",
      "./.venv/Scripts/python.exe -m unittest tests.test_command_contracts -v": "allow",
      "./.venv/Scripts/python.exe -m unittest tests.test_opencode_git_permissions -v": "allow",
      "./.venv/Scripts/python.exe -m unittest tests.test_opencode_permissions -v": "allow",
      "./.venv/Scripts/python.exe -m unittest discover -s tests -p \"test_*.py\" -v": "allow",
      "./.venv/Scripts/python.exe -m compileall -q tools/project_registry.py tools/registry_yaml.py tests/test_project_registry.py": "allow",
      "./.venv/Scripts/python.exe -m compileall -q tools tests": "allow",
      "./.venv/Scripts/python.exe tools/registry_snapshot.py": "allow",
      "./.venv/Scripts/python.exe tools/sync_repositories.py": "ask",
      "./.venv/Scripts/python.exe tools/sync_repositories.py --registry-sha256 *": "ask",
      "./.venv/Scripts/python.exe tools/sync_repositories.py --project *": "ask",
      "./.venv/Scripts/python.exe tools/send_mail.py --list-users": "allow",
      "./.venv/Scripts/python.exe tools/send_mail.py --validate-user [A-Za-z0-9]": "allow",
      "./.venv/Scripts/python.exe tools/send_mail.py --validate-user [A-Za-z0-9][A-Za-z0-9_-]*": "allow",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user [A-Za-z0-9]*@[A-Za-z0-9]*.[A-Za-z0-9]*": "allow",
      "./.venv/Scripts/python.exe tools/send_mail.py --send --user * --markdown reports/daily/**/*.md --html reports/daily/**/*.html": "ask",
      "python tools/send_mail.py --validate-user * *": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --validate-user * *": "deny",
      "python tools/send_mail.py --resolve-user * *": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user * *": "deny",
      "python tools/send_mail.py --validate-user *[!A-Za-z0-9_-]*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --validate-user *[!A-Za-z0-9_-]*": "deny",
      "python tools/send_mail.py --resolve-user *[!A-Za-z0-9._+@-]*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *[!A-Za-z0-9._+@-]*": "deny",
      "python tools/send_mail.py --resolve-user *@*@*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*@*": "deny",
      "python tools/send_mail.py --resolve-user *@*_*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*_*": "deny",
      "python tools/send_mail.py --resolve-user *@*+*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*+*": "deny",
      "python tools/send_mail.py --resolve-user *@-*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@-*": "deny",
      "python tools/send_mail.py --resolve-user *@*.-*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*.-*": "deny",
      "python tools/send_mail.py --resolve-user *@*-.*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*-.*": "deny",
      "python tools/send_mail.py --resolve-user *@*..*": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*..*": "deny",
      "python tools/send_mail.py --resolve-user *@*.": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*.": "deny",
      "python tools/send_mail.py --resolve-user *@*-": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --resolve-user *@*-": "deny",
      "python tools/send_mail.py --send --user * * --markdown *": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --send --user * * --markdown *": "deny",
      "python tools/send_mail.py --send --user * --markdown * * --html *": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --send --user * --markdown * * --html *": "deny",
      "python tools/send_mail.py --send --user * --markdown * --html * *": "deny",
      "./.venv/Scripts/python.exe tools/send_mail.py --send --user * --markdown * --html * *": "deny",
      "git * log --show-signature": "deny",
      "git * log --show-signature *": "deny",
      "git * log * --show-signature": "deny",
      "git * log * --show-signature *": "deny",
      "git * show --show-signature": "deny",
      "git * show --show-signature *": "deny",
      "git * show * --show-signature": "deny",
      "git * show * --show-signature *": "deny",
      "git *--no-index*": "deny",
      "git *--output*": "deny",
      "git *--ext-diff*": "deny",
      "git *--textconv*": "deny",
      "git *--exec*": "deny",
      "git *--exec-path*": "deny",
      "git *--paginate*": "deny",
      "git *--force*": "deny",
