{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_REVIEW_MODEL}",
  "instructions": [
    "AGENTS.md"
  ],
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "formatter": false,
  "lsp": false,
  "permission": {
    "*": "deny",
    "read": {
      "*": "deny",
      "AGENTS.md": "allow",
      ".opencode/**": "allow",
      "standards/**": "allow",
      "data/code/**": "allow",
      "tools/sync_repositories.py": "allow",
      "tools/sync_safety.py": "allow",
      "tools/send_mail.py": "allow",
      "reports/**": "deny",
      "reports/daily/**/*.md": "allow",
      "reports/daily/**/*.html": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "edit": {
      "*": "deny",
      "reports/**": "deny",
      "reports/daily/**/*.md": "allow",
      "reports/daily/**/*.html": "allow"
    },
    "glob": "deny",
    "grep": "deny",
    "skill": {
      "*": "deny",
      "code-review-email-style": "allow"
    },
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "deny",
      "cat *": "deny",
      "type *": "deny",
      "Get-Content *": "deny",
      "env": "deny",
      "env *": "deny",
      "set": "deny",
      "set *": "deny",
      "export *": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "*Env:*": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",
      "bun *": "deny",
      "deno *": "deny",
      "uv *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "poetry *": "deny",
      "cargo *": "deny",
      "go *": "deny",
      "dotnet *": "deny",
      "mvn *": "deny",
      "gradle *": "deny",
      "gradlew *": "deny",
      "make *": "deny",
      "cmake *": "deny",
      "pytest *": "deny",
      "tox *": "deny",
      "nox *": "deny",
      "python -m pytest *": "deny",
      "python -m unittest *": "deny",
      "python *": "deny",
      "git *": "deny",
      "git --no-pager -c core.hooksPath=NUL -c core.fsmonitor=false -c core.pager=cat -c color.ui=false -c diff.external= -c interactive.diffFilter= -c protocol.ext.allow=never log --no-show-signature --no-ext-diff --no-textconv --no-color *": "allow",
      "git --no-pager -c core.hooksPath=NUL -c core.fsmonitor=false -c core.pager=cat -c color.ui=false -c diff.external= -c interactive.diffFilter= -c protocol.ext.allow=never diff --no-ext-diff --no-textconv --no-color *": "allow",
      "git --no-pager -c core.hooksPath=NUL -c core.fsmonitor=false -c core.pager=cat -c color.ui=false -c diff.external= -c interactive.diffFilter= -c protocol.ext.allow=never show --no-show-signature --no-ext-diff --no-textconv --no-color *": "allow",
      "python tools/sync_repositories.py": "ask",
      "python tools/sync_repositories.py --project \"api\"": "ask",
      "python tools/sync_repositories.py --project \"web\"": "ask",
      "python tools/sync_repositories.py --project \"jobs\"": "ask",
      "python tools/send_mail.py --list-users": "allow",
      "python tools/send_mail.py --validate-user [A-Za-z0-9]": "allow",
      "python tools/send_mail.py --validate-user [A-Za-z0-9][A-Za-z0-9_-]*": "allow",
      "python tools/send_mail.py --resolve-user [A-Za-z0-9]*@[A-Za-z0-9]*.[A-Za-z0-9]*": "allow",
      "python tools/send_mail.py --send --user * --markdown reports/daily/**/*.md --html reports/daily/**/*.html": "ask",
      "python tools/send_mail.py --validate-user * *": "deny",
      "python tools/send_mail.py --resolve-user * *": "deny",
      "python tools/send_mail.py --validate-user *[!A-Za-z0-9_-]*": "deny",
      "python tools/send_mail.py --resolve-user *[!A-Za-z0-9._+@-]*": "deny",
      "python tools/send_mail.py --resolve-user *@*@*": "deny",
      "python tools/send_mail.py --resolve-user *@*_*": "deny",
      "python tools/send_mail.py --resolve-user *@*+*": "deny",
      "python tools/send_mail.py --resolve-user *@-*": "deny",
      "python tools/send_mail.py --resolve-user *@*.-*": "deny",
      "python tools/send_mail.py --resolve-user *@*-.*": "deny",
      "python tools/send_mail.py --resolve-user *@*..*": "deny",
      "python tools/send_mail.py --resolve-user *@*.": "deny",
      "python tools/send_mail.py --resolve-user *@*-": "deny",
      "python tools/send_mail.py --send --user * * --markdown *": "deny",
      "python tools/send_mail.py --send --user * --markdown * * --html *": "deny",
      "python tools/send_mail.py --send --user * --markdown * --html * *": "deny",
      "git * log --show-signature": "deny",
      "git * log --show-signature *": "deny",
      "git * log * --show-signature": "deny",
      "git * log * --show-signature *": "deny",
      "git * show --show-signature": "deny",
      "git * show --show-signature *": "deny",
      "git * show * --show-signature": "deny",
      "git * show * --show-signature *": "deny",
      "git *--no-index*": "deny",
      "git *--output*": "deny",
      "git *--ext-diff*": "deny",
      "git *--textconv*": "deny",
      "git *--exec*": "deny",
      "git *--exec-path*": "deny",
      "git *--paginate*": "deny",
      "git *--force*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git fetch*": "deny",
      "git pull*": "deny",
      "git clone*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "*;*": "deny",
      "*&*": "deny",
      "*&&*": "deny",
      "*||*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*`*": "deny",
      "*$*": "deny",
      "*@(*": "deny",
      "*(*": "deny",
      "*)*": "deny",
      "*{*": "deny",
      "*}*": "deny",
      "*^*": "deny",
      "*%*": "deny",
      "*#*": "deny",
      "*,*": "deny",
      "*\r*": "deny",
      "*\n*": "deny"
    }
  }
}
