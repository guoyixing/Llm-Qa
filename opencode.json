      "git rebase*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git restore*": "deny",
      "git commit *--amend*": "deny",
      "git commit *--no-verify*": "deny",
      "git commit *-n*": "deny",
      "git push*": "deny",
      "git fetch*": "deny",
      "git pull*": "deny",
      "git clone*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "*;*": "deny",
      "*&*": "deny",
      "*&&*": "deny",
      "*||*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*`*": "deny",
      "*$*": "deny",
      "*@(*": "deny",
      "*(*": "deny",
      "*)*": "deny",
      "*{*": "deny",
      "*}*": "deny",
      "*^*": "deny",
      "*%*": "deny",
      "*#*": "deny",
      "*,*": "deny",
      "*\r*": "deny",
