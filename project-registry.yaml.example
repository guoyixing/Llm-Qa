# 复制并按实际项目修改；示例保持禁用，不得填写仓库 URL、Token 或其他凭据。
version: 1
projects:
  - project_id: example-project
    name: "示例项目"
    code_dir: data/code/example-project
    standards_dir: standards/projects/example-project
    default_branch: main
    repository_url_config_key: PROJECT_EXAMPLE_REPO_URL
    enabled: false
